<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
</head>
<body>
    <h2>This page belongs to @ <%= data.name %></h2>
    <button>follow</button>
    <button>Message</button>


     <p>
        Followers:<%=data.followers %>   &nbsp;&nbsp;&nbsp;
        Following: <%= data.following %> </p>
    <hr>

    <% for (let post of posts){%>
  <img src=<%= "https://plus.unsplash.com/premium_photo-1677545182067-26ac518ef64f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8Y2F0c3xlbnwwfHwwfHx8MA%3D%3D&auto=format&fit=crop&w=800&q=60",%> alt="post" width="400" height="400">
  <p>
    Likes: <%= post.likes %> &nbsp;&nbsp;&nbsp;
    Comments:<%= post.comments %>
  </p>
<%}%>
    
</body>
</html>